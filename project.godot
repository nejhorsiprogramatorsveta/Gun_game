; Engine configuration file.
; Edit through Project > Project Settings in the editor when possible.

config_version=5

[application]

config/name="gun_game"
config/version="0.2.14"
run/main_scene="res://src/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Settings="*res://src/autoload/settings.gd"
Session="*res://src/autoload/session.gd"

[debug]

file_logging/enable_file_logging=false
file_logging/enable_file_logging.pc=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://assets/ui/theme.tres"

theme/custom_font="res://assets/fonts/Jersey15.ttf"

[input]

move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
fire={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":1)]
}
ability={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":2), Object(InputEventKey,"physical_keycode":69)]
}
reload={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":81)]
}

[internationalization]

locale/translations=PackedStringArray("res://localization/translations.cs.translation")
locale/fallback="cs"

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="platform_oneway"
2d_physics/layer_3="players"
2d_physics/layer_4="projectiles"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.11, 0.12, 0.17, 1)
